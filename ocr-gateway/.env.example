# iOS-OCR-Server displayed address (same office LAN)
IOS_OCR_BASE_URL=http://192.168.1.50:8000

# Optional now; set a long random value before exposing the gateway externally.
GATEWAY_API_KEY=

IOS_TIMEOUT_SECONDS=90

# If the configured iPhone IP stops responding, scan private local /24 networks
# for the upstream iOS-OCR-Server on the same port and switch automatically.
IOS_OCR_AUTO_DISCOVERY=true
IOS_OCR_DISCOVERY_TIMEOUT_SECONDS=0.35
IOS_OCR_DISCOVERY_COOLDOWN_SECONDS=20
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=5
MAX_IMAGE_DIMENSION=3400
